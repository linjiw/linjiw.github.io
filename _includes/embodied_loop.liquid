{% assign loop_variant = include.variant | default: 'light' %}
<figure
  class="learning-loop learning-loop--{{ loop_variant }}"
  aria-label="Animated robot-learning loop: observe the environment, estimate capability, adapt the curriculum, and act"
>
  <div class="learning-loop__viewport" aria-hidden="true">
    <div class="learning-loop__status">
      <span class="learning-loop__live"></span>
      adaptive curriculum
      <span>illustration</span>
    </div>
    <svg class="learning-loop__scene" viewBox="0 0 320 150" focusable="false">
      <path class="learning-loop__course" d="M34 114 C80 108 82 78 122 80 S172 112 208 94 S250 52 284 42"></path>

      <g class="learning-loop__checkpoint" transform="translate(34 114)">
        <circle r="8"></circle>
        <text x="-14" y="20">01</text>
      </g>
      <g class="learning-loop__checkpoint" transform="translate(122 80)">
        <circle r="8"></circle>
        <text x="-14" y="20">02</text>
      </g>
      <g class="learning-loop__checkpoint" transform="translate(208 94)">
        <circle r="8"></circle>
        <text x="-14" y="20">03</text>
      </g>
      <g class="learning-loop__checkpoint learning-loop__checkpoint--goal" transform="translate(284 42)">
        <circle r="11"></circle>
        <path d="M0-6 2-2 7-1 3 2 4 7 0 4-4 7-3 2-7-1-2-2Z"></path>
        <text x="-28" y="25">target</text>
      </g>

      <g class="learning-loop__agent">
        <circle class="learning-loop__policy-pulse" r="19"></circle>
        <rect x="-13" y="-13" width="26" height="19" rx="6"></rect>
        <circle class="learning-loop__eye" cx="-5" cy="-6" r="2"></circle>
        <circle class="learning-loop__eye" cx="5" cy="-6" r="2"></circle>
        <path class="learning-loop__limb" d="M-9 6-15 15M9 6 15 15M-13-2-19 5M13-2 19 5"></path>
        <path class="learning-loop__antenna" d="M0-13V-18"></path>
        <circle class="learning-loop__antenna-tip" cy="-20" r="2.5"></circle>
      </g>

      <g class="learning-loop__sensor" transform="translate(255 18)">
        <path d="M0 9C8 1 18 1 26 9M6 14c4-4 10-4 14 0"></path>
        <circle cx="13" cy="18" r="2.5"></circle>
      </g>
    </svg>
  </div>
  <figcaption class="learning-loop__legend">
    <span>observe</span><i>→</i><span>estimate</span><i>→</i><span>adapt</span><i>→</i><span>act</span>
  </figcaption>
</figure>
