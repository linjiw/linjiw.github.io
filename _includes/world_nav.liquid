<!-- World switcher: persistent pill nav across classic / os / canvas -->
<nav class="world-nav" id="worldNav" aria-label="Site worlds">
  <a href="{{ '/' | relative_url }}" class="world-pill {% if include.active == 'classic' %}active{% endif %}"
     {% if include.active == 'classic' %}aria-current="page"{% endif %}>
    <span class="world-num">01</span>classic
  </a>
  <a href="{{ '/os/' | relative_url }}" class="world-pill {% if include.active == 'os' %}active{% endif %}"
     {% if include.active == 'os' %}aria-current="page"{% endif %}>
    <span class="world-num">02</span>os
  </a>
  <a href="{{ '/canvas/' | relative_url }}" class="world-pill {% if include.active == 'canvas' %}active{% endif %}"
     {% if include.active == 'canvas' %}aria-current="page"{% endif %}>
    <span class="world-num">03</span>canvas
  </a>
</nav>
<div class="world-fade" id="worldFade" aria-hidden="true"></div>
<script>
  (function() {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fade = document.getElementById('worldFade');
    document.querySelectorAll('#worldNav .world-pill:not(.active)').forEach(function(pill) {
      pill.addEventListener('click', function(e) {
        if (reduced || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        fade.classList.add('active');
        setTimeout(function() { window.location.href = pill.href; }, 260);
      });
    });
    // arriving: fade back in
    window.addEventListener('pageshow', function() { fade.classList.remove('active'); });
  })();
</script>
