<!-- World switcher: persistent pill nav across os / canvas / classic -->
<nav class="world-nav world-nav--{{ include.active }}" id="worldNav" aria-label="Site worlds">
  <a href="{{ '/' | relative_url }}" class="world-pill {% if include.active == 'os' %}active{% endif %}"
     aria-label="OS: interactive portfolio" title="OS · interactive portfolio"
     {% if include.active == 'os' %}aria-current="page"{% endif %}>
    <span class="world-num">01</span><span class="world-word">os</span>
  </a>
  <a href="{{ '/canvas/' | relative_url }}" class="world-pill {% if include.active == 'canvas' %}active{% endif %}"
     aria-label="Canvas: guided research map" title="Canvas · guided research map"
     {% if include.active == 'canvas' %}aria-current="page"{% endif %}>
    <span class="world-num">02</span><span class="world-word">canvas</span>
  </a>
  <a href="{{ '/classic/' | relative_url }}" class="world-pill {% if include.active == 'classic' %}active{% endif %}"
     aria-label="Classic: conventional portfolio" title="Classic · conventional portfolio"
     {% if include.active == 'classic' %}aria-current="page"{% endif %}>
    <span class="world-num">03</span><span class="world-word">classic</span>
  </a>
</nav>
<div class="world-fade" id="worldFade" aria-hidden="true"></div>
<script>
  (function() {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fade = document.getElementById('worldFade');
    document.querySelectorAll('#worldNav .world-pill:not(.active)').forEach(function(pill) {
      pill.addEventListener('click', function(e) {
        if (reduced || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        fade.classList.add('active');
        setTimeout(function() { window.location.href = pill.href; }, 260);
      });
    });
    // arriving: fade back in
    window.addEventListener('pageshow', function() { fade.classList.remove('active'); });
  })();
</script>
